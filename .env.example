# Copy to .env and fill in local values. Never commit .env.
# Placeholders only — no live credentials.

# Django
# Production (DEBUG unset or False) refuses SECRET_KEY=change-me / your-secret-key-here.
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Required in production for HTTPS POSTs (login, register, contact).
# Comma-separated origins WITH scheme. Local HTTP examples:
# CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# On Render, https://$RENDER_EXTERNAL_HOSTNAME is appended automatically.
# Custom domain example: CSRF_TRUSTED_ORIGINS=https://houseme.example.com
CSRF_TRUSTED_ORIGINS=

# PostgreSQL (used by Django and docker-compose)
# Local / Docker: discrete DB_* vars.
DB_NAME=houseme_db
DB_USER=houseme
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
# Render Blueprint sets DATABASE_URL from the managed Postgres connectionString.
# When DATABASE_URL is set, it wins over DB_*.
# DATABASE_URL=postgres://houseme:change-me@localhost:5432/houseme_db

# Mapbox public token (pk.*) — set URL restrictions in the Mapbox dashboard
MAPBOX_ACCESS_TOKEN=

# Contact form (console backend by default — logs the message, does not SMTP)
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# DEFAULT_FROM_EMAIL=noreply@localhost
# CONTACT_EMAIL=webmaster@localhost

# --- Render notes ----------------------------------------------------------
# RENDER_EXTERNAL_HOSTNAME is injected by Render (do not set locally).
# settings.py adds it to ALLOWED_HOSTS and CSRF_TRUSTED_ORIGINS.
# Blueprint also sets ALLOWED_HOSTS=.onrender.com
# After first deploy the live URL is https://<RENDER_EXTERNAL_HOSTNAME>
# For a custom domain, add the host to ALLOWED_HOSTS and
# https://your.domain to CSRF_TRUSTED_ORIGINS in the Render Dashboard.
